{
  "name": "dsh-exomind",
  "version": "0.3.0",
  "description": "ExoMind knowledge flywheel tools (search / entity / query) for DeepSeek Harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "exomind",
    "memory",
    "knowledge-base"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0 || >=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0 || >=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3"
  }
}
